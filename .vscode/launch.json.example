{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}",
      // "program": "${file}",
      "env": {
        // "TF_LOG": "TRACE",
        // "TF_LOG_PATH": "./terraform-provider-cpln-log.txt",
        "TF_ACC": "1",
        // "VALIDATE_DOMAINS": false,
        "CPLN_ENDPOINT": "https://api.cpln.io",
        "CPLN_PROFILE": "terraform",
        // "CPLN_PROFILE": "default",
        "GOOGLE_APPLICATION_CREDENTIALS": "/path/google-application-creds.json",
        "GOOGLE_PROJECT": "my-project",
        "CPLN_ORG": "my-org",
        "CPLN_REFRESH_TOKEN": ""
      },
      "args": ["-test.run", "TestAccControlPlaneMk8s_basic", "-test.v"]
    }
  ]
}
